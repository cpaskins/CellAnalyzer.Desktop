<Window x:Class="CellAnalyzer.Desktop.PipelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cell Analyzer – Pipeline"
        Height="800" Width="1200"
        Background="{DynamicResource BgBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                Background="#FF0D1016"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: image management -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="Add Images"
                            Width="110" Margin="0,0,8,0"
                            Click="AddImages_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Add Folder"
                            Width="110" Margin="0,0,8,0"
                            Click="AddFolder_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Remove Selected"
                            Width="130" Margin="0,0,8,0"
                            Click="RemoveSelected_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="Clear All"
                            Width="90"
                            Click="ClearAll_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>

                <!-- Right: run controls + progress -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText"
                               Text="0 / 0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontWeight="Bold"/>
                    <ProgressBar x:Name="PipelineProgressBar"
                                 Width="180" Height="6"
                                 Minimum="0" Maximum="1" Value="0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource BorderBrushTheme}"
                                 BorderThickness="0"
                                 Margin="0,0,16,0"/>
                    <Button x:Name="RunButton"
                            Content="Run Pipeline"
                            Width="120"
                            Click="RunPipeline_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Results DataGrid ── -->
        <DataGrid Grid.Row="1"
                  x:Name="ResultsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="{DynamicResource PanelBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource PanelBrush}"
                  AlternatingRowBackground="#FF1A1F28"
                  BorderBrush="{DynamicResource BorderBrushTheme}"
                  BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrushTheme}"
                  VerticalGridLinesBrush="Transparent"
                  ColumnHeaderHeight="32"
                  RowHeight="28"
                  SelectionChanged="ResultsGrid_SelectionChanged">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF0D1016"/>
                    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushTheme}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF223A64"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF1B2130"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF1B2D4A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="#"
                                    Binding="{Binding Index}"
                                    Width="50"/>
                <DataGridTextColumn Header="File Name"
                                    Binding="{Binding FileName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding StatusDisplay}"
                                    Width="100"/>
                <DataGridTextColumn Header="Cell Count"
                                    Binding="{Binding CellCountDisplay}"
                                    Width="100"/>
                <DataGridTextColumn Header="Total Area (µm²)"
                                    Binding="{Binding TotalAreaDisplay}"
                                    Width="140"/>
                <DataGridTextColumn Header="Mean Area (µm²)"
                                    Binding="{Binding MeanAreaDisplay}"
                                    Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── GridSplitter ── -->
        <GridSplitter Grid.Row="2"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      Cursor="SizeNS"/>

        <!-- ── Image Preview ── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="0,0,5,0">
                <Viewbox Stretch="Uniform">
                    <Image x:Name="PreviewOriginal"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Viewbox>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushTheme}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8"
                    Margin="5,0,0,0">
                <Viewbox Stretch="Uniform">
                    <Image x:Name="PreviewOverlay"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
</Window>
